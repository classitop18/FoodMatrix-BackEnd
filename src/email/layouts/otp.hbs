<!-- Header Icon -->
<div style="margin-bottom: 24px; text-align: center;">
  <span
    style="display: inline-block; width: 56px; height: 56px; background-color: #f3f0fd; border-radius: 50%; text-align: center; line-height: 56px; font-size: 28px;"
  >🔐</span>
</div>

<!-- Title -->
<h2
  style="font-family: 'Manrope', sans-serif; font-size: 24px; font-weight: 800; color: #3d326d; margin: 0 0 16px 0; text-align: center; letter-spacing: -0.5px;"
>
  Security Verification
</h2>

<!-- Content -->
<p
  style="font-family: 'Manrope', sans-serif; font-size: 15px; color: #6b7280; margin: 0 0 32px 0; text-align: center; line-height: 1.6;"
>
  Please use the following code to complete your verification.<br />This code
  will expire in
  <strong style="color: #313131;">{{expiresMins}} minutes</strong>.
</p>

<!-- OTP Display -->
<table
  border="0"
  cellpadding="0"
  cellspacing="0"
  width="100%"
  style="margin-bottom: 32px;"
>
  <tr>
    <td align="center">
      <div
        style="display: inline-block; padding: 24px 48px; background-color: #f8f7ff; border: 2px dashed #7661d3; border-radius: 16px;"
      >
        <span
          style="font-family: 'Courier New', monospace; font-size: 36px; font-weight: 800; letter-spacing: 8px; color: #3d326d;"
        >
          {{otp}}
        </span>
      </div>
    </td>
  </tr>
</table>

<!-- Security Warning -->
<div
  style="padding: 16px; background-color: #fffbeb; border-radius: 12px; border-left: 4px solid #f59e0b;"
>
  <table border="0" cellpadding="0" cellspacing="0">
    <tr>
      <td
        style="vertical-align: top; padding-right: 12px; font-size: 18px;"
      >🛡️</td>
      <td>
        <p
          style="margin: 0; font-size: 13px; color: #92400e; line-height: 1.5;"
        >
          <strong>Security Tip:</strong>
          Never share this code with anyone. configuration staff will never ask
          for this code.
        </p>
      </td>
    </tr>
  </table>
</div>