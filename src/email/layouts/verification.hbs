<h1 style="font-size:24px; font-weight:700; color:#222; margin-bottom:16px;">
  Verify Your Email
</h1>

<p style="font-size:15px; color:#444; line-height:1.6; margin-bottom:12px;">
  Hi
  {{name}},
</p>

<p style="font-size:15px; color:#444; line-height:1.6; margin-bottom:24px;">
  Thanks for joining
  <strong>FoodMatrix</strong>! Please verify your email address to activate your
  account.
</p>

{{verifyUrl}}

<!-- Form for POST method -->
<a
  href="{{verifyUrl}}"
  style="
    display:inline-block;
    background:#2ecc71;
    padding:14px 28px;
    color:#ffffff;
    text-decoration:none;
    border-radius:8px;
    font-size:16px;
    font-weight:600;
    margin:16px 0;
  "
>
  Verify My Email
</a>

<p style="font-size:14px; color:#666; line-height:1.6; margin-top:24px;">
  If you did not create an account, you can safely ignore this email.
</p>