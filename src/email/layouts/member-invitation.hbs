<!-- Invitation Header -->
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 24px;">
  <tr>
    <td align="center">
      <div
        style="width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #f3f0fd 0%, #ffffff 100%); box-shadow: 0 8px 16px rgba(118, 97, 211, 0.1); line-height: 64px; text-align: center; font-size: 32px;">
        📨
      </div>
    </td>
  </tr>
</table>

<!-- Title -->
<h2
  style="font-family: 'Manrope', sans-serif; font-size: 24px; font-weight: 800; color: #3d326d; margin: 0 0 16px 0; text-align: center;">
  Join {{accountName}}
</h2>

<!-- Personal Message -->
<p
  style="font-family: 'Manrope', sans-serif; font-size: 16px; color: #4b5563; margin: 0 0 32px 0; text-align: center; line-height: 1.6;">
  Hi <strong style="color: #313131;">{{inviteeName}}</strong>,<br>
  <strong style="color: #7661d3;">{{inviterName}}</strong> has invited you to join their household account on
  FoodMatrix.
</p>

<!-- Feature Box -->
<div
  style="padding: 24px; background-color: #f8f7ff; border-radius: 16px; border: 1px solid rgba(118, 97, 211, 0.1); margin-bottom: 32px;">
  <p
    style="margin: 0 0 16px 0; font-size: 14px; font-weight: 700; color: #3d326d; text-transform: uppercase; letter-spacing: 0.5px; text-align: center;">
    Collaborate Together
  </p>

  <table border="0" cellpadding="0" cellspacing="0" width="100%">
    <tr>
      <td width="33%" align="center" style="padding: 8px;">
        <div style="font-size: 24px; margin-bottom: 8px;">📅</div>
        <div style="font-size: 13px; color: #4b5563; font-weight: 600;">Meal Plans</div>
      </td>
      <td width="33%" align="center"
        style="padding: 8px; border-left: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb;">
        <div style="font-size: 24px; margin-bottom: 8px;">🛒</div>
        <div style="font-size: 13px; color: #4b5563; font-weight: 600;">Groceries</div>
      </td>
      <td width="33%" align="center" style="padding: 8px;">
        <div style="font-size: 24px; margin-bottom: 8px;">💰</div>
        <div style="font-size: 13px; color: #4b5563; font-weight: 600;">Budget</div>
      </td>
    </tr>
  </table>
</div>

<!-- Main CTA -->
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 24px 0;">
  <tr>
    <td align="center">
      <a href="{{acceptLink}}"
        style="display: inline-block; background: linear-gradient(135deg, #7661d3 0%, #3d326d 100%); color: #ffffff; font-family: 'Manrope', sans-serif; font-size: 16px; font-weight: 700; text-decoration: none; padding: 18px 48px; border-radius: 14px; box-shadow: 0 10px 20px rgba(118, 97, 211, 0.25);">
        Accept Invitation
      </a>
    </td>
  </tr>
</table>

<!-- Expiry Warning -->
<p
  style="text-align: center; font-size: 13px; color: #92400e; background-color: #fffbeb; padding: 8px 16px; border-radius: 20px; display: inline-block; margin: 0 auto;">
  ⏰ Expires in 7 days
</p>